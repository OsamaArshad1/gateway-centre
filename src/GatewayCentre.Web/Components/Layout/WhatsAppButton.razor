@inject Services.SiteContentService SiteContent

@if (!string.IsNullOrWhiteSpace(_settings.WhatsAppNumber))
{
    <a class="whatsapp-fab"
       href="@GetLink()"
       target="_blank"
       rel="noopener"
       aria-label="Chat with us on WhatsApp">
        <svg viewBox="0 0 32 32" width="26" height="26" fill="currentColor" aria-hidden="true">
            <path d="M16.02 2.67c-7.36 0-13.33 5.97-13.33 13.33 0 2.35.62 4.65 1.79 6.67L2.67 29.33l6.83-1.79a13.28 13.28 0 0 0 6.52 1.72h.01c7.36 0 13.33-5.97 13.33-13.33S23.38 2.67 16.02 2.67zm0 24.4a11 11 0 0 1-5.6-1.53l-.4-.24-4.05 1.06 1.08-3.95-.26-.41a10.98 10.98 0 0 1-1.68-5.87c0-6.08 4.95-11.03 11.02-11.03 2.95 0 5.72 1.15 7.8 3.24a10.95 10.95 0 0 1 3.23 7.8c0 6.08-4.95 11.03-11.14 11.03zm6.04-8.25c-.33-.17-1.96-.97-2.26-1.08-.3-.11-.53-.17-.75.17-.22.33-.86 1.08-1.05 1.3-.19.22-.39.25-.72.08-.33-.17-1.4-.52-2.66-1.65-.98-.88-1.65-1.96-1.84-2.29-.19-.33-.02-.51.15-.68.15-.15.33-.39.5-.58.17-.19.22-.33.33-.55.11-.22.06-.42-.03-.58-.08-.17-.75-1.8-1.02-2.47-.27-.65-.55-.56-.75-.57h-.64c-.22 0-.58.08-.88.42-.3.33-1.15 1.13-1.15 2.75s1.18 3.19 1.34 3.41c.17.22 2.32 3.55 5.63 4.97.79.34 1.4.55 1.88.7.79.25 1.51.21 2.08.13.63-.1 1.96-.8 2.24-1.58.28-.77.28-1.44.19-1.58-.08-.14-.3-.22-.63-.39z" />
        </svg>
    </a>
}

@code {
    private Models.SiteSettings _settings = new();

    protected override async Task OnInitializedAsync()
    {
        _settings = await SiteContent.GetSettingsAsync();
    }

    private string GetLink()
    {
        var digits = new string(_settings.WhatsAppNumber!.Where(char.IsDigit).ToArray());
        return $"https://wa.me/{digits}?text=" + Uri.EscapeDataString("Hi Gateway Centre, I'd like to know more about booking your venue.");
    }
}
