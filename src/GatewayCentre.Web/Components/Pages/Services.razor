@page "/services"

<PageTitle>Services — Gateway Centre</PageTitle>

<section class="page-hero">
    <div class="gc-container">
        <span class="section-eyebrow" style="background:rgba(255,255,255,.16);color:#fff;">What We Offer</span>
        <h1 style="color:#fff;">Full-Service Event Support</h1>
        <OrnamentDivider Light="true" />
        <p style="color:rgba(255,255,255,.85);max-width:560px;">From the first phone call to the last guest leaving, our team handles the details so you can enjoy the occasion.</p>
    </div>
</section>

<section class="section">
    <div class="gc-container">
        <div class="grid grid-2">
            <div class="gc-card">
                <div class="gc-card-body">
                    <div class="highlight-icon" style="margin:0 0 16px;">💍</div>
                    <h3>Weddings &amp; Receptions</h3>
                    <p class="gc-text-muted">Baraat, walima, mehndi or reception — our halls and event team adapt to every stage of a Pakistani wedding, with staging, seating layouts and coordination handled for you.</p>
                </div>
            </div>
            <div class="gc-card">
                <div class="gc-card-body">
                    <div class="highlight-icon" style="margin:0 0 16px;">🏢</div>
                    <h3>Corporate Events</h3>
                    <p class="gc-text-muted">Conferences, seminars, and company functions with flexible seating, sound and projection support for up to several hundred attendees.</p>
                </div>
            </div>
            <div class="gc-card">
                <div class="gc-card-body">
                    <div class="highlight-icon" style="margin:0 0 16px;">🍽</div>
                    <h3>Catering Services</h3>
                    <p class="gc-text-muted">In-house catering coordination covering everything from traditional multi-course menus to live counters, tailored to your guest count and budget.</p>
                </div>
            </div>
            <div class="gc-card">
                <div class="gc-card-body">
                    <div class="highlight-icon" style="margin:0 0 16px;">📋</div>
                    <h3>Custom Menu Planning</h3>
                    <p class="gc-text-muted">Work directly with our team to design a menu around your preferences, dietary needs and cultural traditions.</p>
                </div>
            </div>
        </div>

        <div style="text-align:center;margin-top:48px;">
            <a href="/request-a-quote" class="gc-btn gc-btn-primary">Request a Quote for Your Event</a>
        </div>
    </div>
</section>
