@inject SiteContentService SiteContent

<div class="social-links @CssClass">
    @if (!string.IsNullOrWhiteSpace(_settings.FacebookUrl))
    {
        <a href="@_settings.FacebookUrl" target="_blank" rel="noopener" aria-label="Facebook">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V8c0-.9.25-1.5 1.55-1.5H17V3.7C16.7 3.65 15.75 3.5 14.6 3.5c-2.3 0-3.9 1.4-3.9 4v2.4H8v3.1h2.7V21h2.8z"/></svg>
        </a>
    }
    @if (!string.IsNullOrWhiteSpace(_settings.InstagramUrl))
    {
        <a href="@_settings.InstagramUrl" target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
    }
    @if (!string.IsNullOrWhiteSpace(_settings.TwitterUrl))
    {
        <a href="@_settings.TwitterUrl" target="_blank" rel="noopener" aria-label="X (Twitter)">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M13.6 10.6 20 3.5h-1.9l-5.5 6.1-4.4-6.1H3l6.7 9.3L3 20.9h1.9l5.9-6.5 4.7 6.5H21l-7-9.8Zm-2.1 2.3-.7-.9-5.4-7.4H8l4.3 6 .7.9 5.7 7.9h-2.6l-4.6-6.5Z"/></svg>
        </a>
    }
    @if (!string.IsNullOrWhiteSpace(_settings.WhatsAppNumber))
    {
        <a href="@WhatsAppLink" target="_blank" rel="noopener" aria-label="WhatsApp">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2.7a9.3 9.3 0 0 0-8 14l-1 3.6 3.7-1a9.3 9.3 0 1 0 5.3-16.6Zm0 17a7.6 7.6 0 0 1-3.9-1.1l-.3-.2-2.3.6.6-2.2-.2-.3a7.7 7.7 0 1 1 6.1 3.2Zm4.2-5.7c-.2-.1-1.3-.7-1.6-.7-.2-.1-.4-.1-.5.1-.2.2-.6.7-.7.9-.1.1-.3.2-.5.1a6.3 6.3 0 0 1-3.1-2.7c-.2-.4.2-.4.6-1.2.1-.1 0-.3 0-.4l-.7-1.6c-.2-.4-.4-.3-.5-.3h-.4c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 1.9s.9 2.2 1 2.3c.1.2 1.7 2.6 4.1 3.6.6.2 1 .4 1.4.5.6.2 1.1.1 1.5-.1.5-.1 1.3-.5 1.5-1 .2-.5.2-.9.1-1Z"/></svg>
        </a>
    }
</div>

@code {
    [Parameter] public string CssClass { get; set; } = string.Empty;

    private Models.SiteSettings _settings = new();

    protected override async Task OnInitializedAsync()
    {
        _settings = await SiteContent.GetSettingsAsync();
    }

    private string WhatsAppLink
    {
        get
        {
            var digits = new string(_settings.WhatsAppNumber!.Where(char.IsDigit).ToArray());
            return $"https://wa.me/{digits}";
        }
    }
}
